/* ---------- GENERIC MC ---------- */
$$('.mcq').forEach(function(q){
  $$('.opt',q).forEach(function(o){
    o.addEventListener('click',function(){
      $$('.opt',q).forEach(function(x){x.classList.remove('sel');});
      o.classList.add('sel');
    });
  });
});
function gradeGroup(ex){
  var qs=$$('.mcq[data-ex="'+ex+'"]'),c=0;
  qs.forEach(function(q){
    var a=q.getAttribute('data-a'),sel=$('.opt.sel',q);
    $$('.opt',q).forEach(function(o){
      o.classList.remove('ok','bad');
      if(o.getAttribute('data-v')===a)o.classList.add('ok');
    });
    if(sel&&sel.getAttribute('data-v')===a)c++;
    else if(sel)sel.classList.add('bad');
  });
  return {c:c,t:qs.length};
}
function resetGroup(ex){
  $$('.mcq[data-ex="'+ex+'"] .opt').forEach(function(o){o.classList.remove('sel','ok','bad');});
}
