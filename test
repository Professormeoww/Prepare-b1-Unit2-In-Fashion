<script>
(function(){
'use strict';
var $=function(s,r){return (r||document).querySelector(s);};
var $$=function(s,r){return Array.prototype.slice.call((r||document).querySelectorAll(s));};

/* ---------- STATE ---------- */
var TASKS=['1.1','1.2','1.3','1.3P','2.1','2.2','3.1','3.2','3.3','4.1','4.2'];
var TASK_LABELS={
  '1.1':'Ex 1.1 Matching','1.2':'Ex 1.2 Upgrade','1.3':'Ex 1.3 Drag&Drop','1.3P':'Ex 1.3 Personal',
  '2.1':'Ex 2.1 Sorting -ed','2.2':'Ex 2.2 Past Simple MC',
  '3.1':'Ex 3.1 Form Adverb','3.2':'Ex 3.2 Adverb Gaps','3.3':'Ex 3.3 Find Mistake',
  '4.1':'Ex 4.1 Shopping Story','4.2':'Ex 4.2 Fashion Detective'
};
var BLOCK_TASKS={b1:['1.1','1.2','1.3','1.3P'],b2:['2.1','2.2'],b3:['3.1','3.2','3.3'],b4:['4.1','4.2']};
var state={name:'',scores:{},open:{},done:{}};

function persist(){try{localStorage.setItem('u2practice',JSON.stringify(state));}catch(e){}}
function restore(){try{var raw=localStorage.getItem('u2practice');if(raw){var s=JSON.parse(raw);if(s&&typeof s==='object'){state.name=s.name||'';state.scores=s.scores||{};state.open=s.open||{};state.done=s.done||{};}}}catch(e){}}

function fb(id,type,html){var el=$('#'+id);if(!el)return;el.className='fb show '+type;el.innerHTML=html;}

function refresh(){
  var done=TASKS.filter(function(t){return state.done[t];}).length;
  $('#progFill').style.width=(done/TASKS.length*100)+'%';
  $('#progText').textContent=done+' / '+TASKS.length+' tasks completed';
  $$('.tab').forEach(function(tab){
    var t=tab.getAttribute('data-t');
    if(BLOCK_TASKS[t]){
      var all=BLOCK_TASKS[t].every(function(x){return state.done[x];});
      tab.classList.toggle('done',all);
    }
  });
  var cl=$('#checkList');cl.innerHTML='';
  TASKS.forEach(function(t){
    var d=document.createElement('div');
    d.className='ck'+(state.done[t]?' done':'');
    d.innerHTML='<span class="box">'+(state.done[t]?'✓':'')+'</span>'+TASK_LABELS[t];
    cl.appendChild(d);
  });
}
function markDone(t){state.done[t]=true;persist();refresh();}

/* ---------- TABS ---------- */
$$('.tab').forEach(function(tab){
  tab.addEventListener('click',function(){
    $$('.tab').forEach(function(t){t.classList.remove('active');});
    $$('.block').forEach(function(b){b.classList.remove('active');});
    tab.classList.add('active');
    $('#'+tab.getAttribute('data-t')).classList.add('active');
    window.scrollTo({top:0,behavior:'smooth'});
  });
});

/* ---------- OPEN ANSWERS AUTOSAVE ---------- */
$$('[data-open]').forEach(function(el){
  if(state.open[el.id])el.value=state.open[el.id];
  el.addEventListener('input',function(){state.open[el.id]=el.value;persist();});
});
var nameInput=$('#studentName');
nameInput.value=state.name||'';
nameInput.addEventListener('input',function(){state.name=nameInput.value;persist();});

/* ---------- EX 1.1 MATCHING ---------- */
var mMap={},mSel=null;
$$('#mLeft .mitem').forEach(function(el){
  el.addEventListener('click',function(){
    $$('#mLeft .mitem').forEach(function(x){x.classList.remove('sel');});
    el.classList.add('sel');mSel=el.getAttribute('data-k');
  });
});
$$('#mRight .mitem').forEach(function(el){
  el.addEventListener('click',function(){
    if(!mSel)return;
    mMap[mSel]=el.getAttribute('data-k');
    var L=$('#mLeft .mitem[data-k="'+mSel+'"]');
    if(L){L.classList.add('paired');L.classList.remove('sel');}
    el.classList.add('paired');mSel=null;
  });
});
$('#check11').addEventListener('click',function(){
  var c=0;
  for(var i=1;i<=12;i++){
    var ok=mMap[i]===String(i);
    var L=$('#mLeft .mitem[data-k="'+i+'"]'),R=$('#mRight .mitem[data-k="'+i+'"]');
    [L,R].forEach(function(el){el.classList.remove('ok','bad');el.classList.add(ok?'ok':'bad');});
    if(ok)c++;
  }
  state.scores['1.1']={c:c,t:12};markDone('1.1');
  fb('fb11',c===12?'ok':'warn','<b>'+c+'/12</b> correct pairs.'+(c===12?' Perfect! 🎉':' Red items need another look.'));
});
$('#reset11').addEventListener('click',function(){
  mMap={};mSel=null;
  $$('#mLeft .mitem, #mRight .mitem').forEach(function(el){el.classList.remove('sel','paired','ok','bad');});
  $('#fb11').className='fb';
});

