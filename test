/* ---------- EX 2.1 SORTING ---------- */
var selChip=null;
function bindChip(chip){
  chip.addEventListener('click',function(ev){
    ev.stopPropagation();
    if(chip.parentElement.classList.contains('drop')){
      $('#bank21').appendChild(chip);chip.classList.remove('sel');selChip=null;return;
    }
    $$('.chip').forEach(function(c){c.classList.remove('sel');});
    chip.classList.add('sel');selChip=chip;
  });
}
$$('.chip').forEach(bindChip);
['#colT','#colD','#colID'].forEach(function(sel){
