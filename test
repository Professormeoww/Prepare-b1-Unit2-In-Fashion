  ['o12a','Ex 1.2 · Upgrade #1'],['o12b','Ex 1.2 · Upgrade #2'],['o12c','Ex 1.2 · Upgrade #3'],['o12d','Ex 1.2 · Upgrade #4'],
  ['o12e','Ex 1.2 · Upgrade #5'],['o12f','Ex 1.2 · Upgrade #6'],['o12g','Ex 1.2 · Upgrade #7'],['o12h','Ex 1.2 · Upgrade #8'],
  ['pq1','Ex 1.3 · Personal Q1 (favourite item)'],['pq2','Ex 1.3 · Personal Q2 (smart vs casual)'],['pq3','Ex 1.3 · Personal Q3 (new vs second-hand)'],
  ['mist1','Ex 3.3 · Correction #1'],['mist2','Ex 3.3 · Correction #2'],['mist3','Ex 3.3 · Correction #3'],['mist4','Ex 3.3 · Correction #4'],
