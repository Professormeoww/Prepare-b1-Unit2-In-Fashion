  ['imgProfile','Ex 4.2 · Detective Profile (Final Writing)']
];
function remaining(){return TASKS.filter(function(t){return !state.done[t];});}
function buildReport(){
  var L=[];
  L.push('ОТЧЁТ ПО ПРАКТИКЕ · UNIT 2 "IN FASHION"');
  L.push('INTERACTIVE PRACTICE REPORT');
  L.push('==========================================');
  L.push('Студент / Student : '+(state.name||'—'));
  L.push('Дата / Date       : '+new Date().toLocaleString('ru-RU'));
  var done=TASKS.filter(function(t){return state.done[t];}).length;
  L.push('Прогресс          : '+done+' / '+TASKS.length+' заданий');
  L.push('');
  L.push('--- АВТОПРОВЕРКА / AUTO-GRADED ---');
  Object.keys(SCORE_LABELS).forEach(function(k){
    var s=state.scores[k];
    L.push((s?(s.c+' / '+s.t):'не выполнено / not attempted')+'   '+SCORE_LABELS[k]);
  });
  L.push('');
  L.push('--- ПИСЬМЕННЫЕ ЗАДАНИЯ / WRITTEN TASKS ---');
  ['1.2','1.3P','4.1','4.2'].forEach(function(t){
    L.push((state.done[t]?'[выполнено ✓]':'[не выполнено ✗]')+'   '+TASK_LABELS[t]);
  });
  L.push('');
  L.push('--- ОТВЕТЫ УЧЕНИЦЫ / STUDENT ANSWERS ---');
  OPEN_LABELS.forEach(function(pair){
    var v=(state.open[pair[0]]||'').trim();
    L.push('• '+pair[1]+':');
    L.push('  '+(v?v:'(пусто / empty)'));
    L.push('');
  });
  L.push('==========================================');
  L.push('Сформировано автоматически · Interactive Practice Unit 2');
  return L.join('\n');
}
$('#genReport').addEventListener('click',function(){
  var rem=remaining();
  if(rem.length){
    fb('fbRep','warn','Сначала завершите задания / Complete first: '+rem.map(function(t){return TASK_LABELS[t];}).join('; '));
    return;
  }
  $('#reportPre').textContent=buildReport();
  $('#reportPanel').classList.add('show');
  fb('fbRep','ok','Report is ready! Copy, download or print it below.');
  $('#reportPanel').scrollIntoView({behavior:'smooth',block:'start'});
});
$('#copyRep').addEventListener('click',function(){
  var txt=$('#reportPre').textContent;
  function fallback(){
    var ta=document.createElement('textarea');ta.value=txt;document.body.appendChild(ta);
    ta.select();try{document.execCommand('copy');}catch(e){}ta.remove();
    fb('fbRep','ok','Report copied ✓');
  }
  if(navigator.clipboard&&navigator.clipboard.writeText){
    navigator.clipboard.writeText(txt).then(function(){fb('fbRep','ok','Report copied ✓');},fallback);
  }else fallback();
});
$('#dlRep').addEventListener('click',function(){
  var blob=new Blob([$('#reportPre').textContent],{type:'text/plain;charset=utf-8'});
  var a=document.createElement('a');
  a.href=URL.createObjectURL(blob);
  a.download='Unit2_InFashion_report.txt';
  document.body.appendChild(a);a.click();a.remove();
  URL.revokeObjectURL(a.href);
  fb('fbRep','ok','File downloaded ✓');
});
$('#printRep').addEventListener('click',function(){window.print();});

