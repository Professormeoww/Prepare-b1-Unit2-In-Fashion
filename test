/* ---------- EX 3.3 FIND MISTAKE ---------- */
var VAL33=[
  function(v){return /carefully/.test(v);},
  function(v){return /beautifully/.test(v);},
  function(v){return /\bhard\b/.test(v)&&!/hardly/.test(v);},
  function(v){return /correct|no mistake|^ok$|✓|loudly/.test(v);},
  function(v){return /angrily/.test(v);},
  function(v){return /confidently/.test(v);},
  function(v){return /happily/.test(v);},
  function(v){return /heavily/.test(v);}
];
$('#check33').addEventListener('click',function(){
  var c=0,empty=0;
  VAL33.forEach(function(fn,i){
    var el=$('#mist'+(i+1)),v=el.value.trim().toLowerCase();
    if(!v){empty++;}
    var ok=fn(v);
    el.classList.remove('ok','bad');el.classList.add(ok?'ok':'bad');
    if(ok)c++;
  });
  if(empty>0){fb('fb33','warn','Fill in all 8 corrections first.');return;}
  state.scores['3.3']={c:c,t:8};markDone('3.3');
  fb('fb33',c===8?'ok':'warn','<b>'+c+'/8</b> correct. Remember: adjectives describe nouns, adverbs describe verbs!');
});
