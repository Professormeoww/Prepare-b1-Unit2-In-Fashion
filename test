$('#save12').addEventListener('click',function(){
  var filled=O12.filter(function(id){return $('#'+id).value.trim().length>3;}).length;
  if(filled<O12.length){fb('fb12','warn','Please write all '+O12.length+' sentences before saving ('+filled+'/'+O12.length+' done).');return;}
  markDone('1.2');fb('fb12','ok','All 8 answers saved to the teacher report ✓');
});
$('#model12btn').addEventListener('click',function(){$('#model12').classList.toggle('hidden');});

/* ---------- EX 1.3 DRAG AND DROP ---------- */
var draggedWord=null;
$$('.drag-word').forEach(function(word){
  word.addEventListener('dragstart',function(e){
    draggedWord=this;
    e.dataTransfer.setData('text/plain',this.getAttribute('data-w'));
    setTimeout(function(){word.style.opacity='.5';},0);
  });
  word.addEventListener('dragend',function(){this.style.opacity='1';draggedWord=null;});
  
  // Touch support for mobile/tablet
  word.addEventListener('touchstart',function(e){
    draggedWord=this;this.style.opacity='.5';
  },{passive:true});
  word.addEventListener('touchend',function(e){
    this.style.opacity='1';
    var touch=e.changedTouches[0];
    var target=document.elementFromPoint(touch.clientX,touch.clientY);
    if(target&&target.classList.contains('drop-zone')&&!target.classList.contains('filled')){
      fillZone(target,draggedWord);
    }
    draggedWord=null;
  });
});

$$('.drop-zone').forEach(function(zone){
  zone.addEventListener('dragover',function(e){e.preventDefault();this.classList.add('hover');});
  zone.addEventListener('dragleave',function(){this.classList.remove('hover');});
  zone.addEventListener('drop',function(e){
    e.preventDefault();this.classList.remove('hover');
    if(draggedWord&&!this.classList.contains('filled')){
      fillZone(this,draggedWord);
    }
  });
  zone.addEventListener('click',function(){
    if(this.classList.contains('filled')){
      var w=this.getAttribute('data-w');
      var bankWord=$$('.drag-word').find(function(el){return el.getAttribute('data-w')===w;});
      if(bankWord)bankWord.classList.remove('placed');
      this.textContent='';this.classList.remove('filled','ok','bad');this.removeAttribute('data-w');
    }
  });
});

function fillZone(zone,wordEl){
  zone.textContent=wordEl.getAttribute('data-w');
  zone.setAttribute('data-w',wordEl.getAttribute('data-w'));
  zone.classList.add('filled');
  wordEl.classList.add('placed');
}

